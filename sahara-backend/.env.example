[TEMPLATE]
# Sahara backend configuration — copy this to `.env` and fill in real values.
# .env is gitignored — never commit it (it contains credentials).

# MongoDB (local or Atlas — free tier: https://www.mongodb.com/atlas)
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URL=mongodb://localhost:27017
DB_NAME=sahara_db

# Sentiment model (HuggingFace — downloads ~500 MB on first run)
MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment
MODEL_AUTO_DOWNLOAD=true

# Anthropic chat companion (OPTIONAL — Claude)
# Get a key at https://console.anthropic.com (free trial credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini chat companion (OPTIONAL — free tier, no credit card)
# Get a FREE key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash was retired for new users in 2026 — the current
# flash-tier model is gemini-3.6-flash (update if Google ships a new one).
GEMINI_MODEL=gemini-3.6-flash

# Which provider serves the chatbot:
#   auto     = best available: anthropic (if key) > gemini (if key) > built-in fallback
#   anthropic / gemini = force that provider (503 without its key)
#   fallback = built-in rule-based responder (needs NO key or internet)
CHAT_PROVIDER=auto

# MOCK_AI_MODE=true forces deterministic, clearly-labelled sample replies
# for demos/tests (no cloud LLM, no network). Responses report
# provider="mock" — never present mock replies as real AI output.
MOCK_AI_MODE=false

# CORS — which browser origins may call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
